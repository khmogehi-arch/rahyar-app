PORT=4000
JWT_SECRET=change-this-secret-in-production
VISITOR_APP_URL=http://localhost:5174
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Required — a Postgres connection string (e.g. from Neon, or a local
# Postgres for dev: postgres://user:pass@localhost:5432/rahyar).
DATABASE_URL=postgres://user:pass@localhost:5432/rahyar

# Optional. When set, uploaded floor plan images go to Vercel Blob instead
# of local disk — required in production (see README), since Vercel's
# filesystem is read-only outside /tmp and /tmp doesn't persist. Leave unset
# for local dev; uploads then fall back to ./uploads.
# BLOB_READ_WRITE_TOKEN=

# Only needed for the local-disk upload fallback above, and only if you want
# it somewhere other than ./uploads. On Vercel without BLOB_READ_WRITE_TOKEN
# this would default to /tmp/uploads, which does not persist — set the Blob
# token instead of relying on this in production.
# UPLOADS_DIR=/tmp/uploads
